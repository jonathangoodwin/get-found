# Optional. Only needed for --gsc-site-url (Search Console striking-distance data).
# Create OAuth credentials in Google Cloud Console (Search Console API enabled),
# then run any standard OAuth2 installed-app flow once to obtain a refresh token.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# Optional. Enables AI-drafted content briefs (Claude). Without it, briefs
# fall back to a rule-based placeholder — the report still works.
ANTHROPIC_API_KEY=

# Optional. Enables real keyword search volume via DataForSEO instead of the
# competitor-coverage-count heuristic. Get credentials at https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
