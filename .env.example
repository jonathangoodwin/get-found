# Optional. Only needed for --gsc-site-url (striking distance, ranking watch,
# and sitemap status). Create OAuth credentials in Google Cloud Console
# (Search Console API enabled), then run `npm run gsc:auth` to get a refresh token.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# Optional. Enables the Core Web Vitals section via the free Chrome UX
# Report API. Get an API key at https://developers.google.com/web/tools/chrome-user-experience-report/api/guides/getting-started
CRUX_API_KEY=

# Optional. Enables AI-drafted content briefs (Claude). Without it, briefs
# fall back to a rule-based placeholder — the report still works.
ANTHROPIC_API_KEY=

# Optional. Enables real keyword search volume via DataForSEO instead of the
# competitor-coverage-count heuristic. Get credentials at https://dataforseo.com
# The same credentials also power --link-gap (Backlinks API) when that flag is
# passed — a separate, additional cost from keyword volume lookups.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Required only for `get-found slack`. Create a Slack app at
# https://api.slack.com/apps with Socket Mode enabled, a slash command
# named /get-found, and the chat:write + commands scopes.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
